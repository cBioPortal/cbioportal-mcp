{
  "realm": "cbioportal-mcp-local",
  "enabled": true,
  "groups": [
    {"name": "research", "subGroups": [{"name": "alpha"}, {"name": "beta"}]},
    {"name": "cbioportal", "subGroups": [{"name": "admins"}]}
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Alpha",
      "email": "alice@example.org",
      "emailVerified": true,
      "groups": ["/research/alpha"],
      "credentials": [{"type": "password", "value": "alice", "temporary": false}]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Beta",
      "email": "bob@example.org",
      "emailVerified": true,
      "groups": ["/research/beta"],
      "credentials": [{"type": "password", "value": "bob", "temporary": false}]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@example.org",
      "emailVerified": true,
      "groups": ["/cbioportal/admins"],
      "credentials": [{"type": "password", "value": "admin-user", "temporary": false}]
    }
  ],
  "clients": [
    {
      "clientId": "mcp-local",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8001/*"],
      "webOrigins": ["http://localhost:8001"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "mcp-local-proxy",
      "enabled": true,
      "publicClient": false,
      "secret": "mcp-local-proxy-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ]
}
